@using Contracts.Model.Schedule
@model IEnumerable<Schedule>

@{
    ViewData["Title"] = "Задачи";
}

<div class="container">
    @Html.ActionLink("Добавить", "Create", "Schedule", null, new { @class = "btn btn-dark" })    
    <button id="move_next_button" class="btn btn-dark">Переключиться на следующий проект</button>
    @Html.ActionLink("История", "History", "Schedule", null, new { @class = "btn btn-dark" })
    <button id="end_schedule_button" class="btn btn-dark" title="Переключение на следующий элемент расписания">Завершить</button>
    <hr>
    Фильтры:
    <div id="filter">
        <div>
            <span class="col-sm-2">Наименование:</span><input id="filter_name" class="col-sm-4" />
        </div>
        <div>
            <span class="col-sm-2">Только активные:</span><input id="filter_active" type="checkbox" class="col-sm-4" />
        </div>        
        <div>
            <span class="col-sm-2">Дата с:</span><input id="filter_from" class="form-control datetimefield col-sm-4" value="@DateTimeOffset.Now.AddHours(-8).ToString("yyyy-MM-ddThh:mm")" />
        </div>
        <div>
            <span class="col-sm-2">Дата по:</span><input id="filter_to" class="form-control datetimefield col-sm-4" value="@DateTimeOffset.Now.AddMonths(1).ToString("yyyy-MM-ddThh:mm")" />
        </div>
        <div>
            <button id="refresh_filter_button" class="btn btn-dark col-sm-2 offset-1">Показать</button>
        </div>
    </div>
    <div id="content"></div>
    <div>
        <a href="#" id="begin"><<</a>
        <a href="#" id="back"><</a>
        Страница <span id="page">0</span> из <span id="all_pages">0</span>
        <a href="#" id="forward">></a>
        <a href="#" id="end">>></a>
        Показывать по <input id="count_items" value="10" /> элементов на странице
    </div>
</div>

<div class="modal fade" id="modal-action-id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document" style="max-width:1000px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Выбор родителя</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="dialogContent">
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var page = 1;
        var name = "";
        var allPages = 1;

        function refresh() {
            $('#page').html(page);
            $.get("Schedule/ListPaged/?page=" + (page - 1) + "&size=" + $('#count_items').val()
                + "&name=" + $('#filter_name').val() + "&onlyActive=" + $('#filter_active').is(':checked')              
                + "&fromDate=" + $('#filter_from').val()
                + "&toDate=" + $('#filter_to').val(),
                function (data, textStatus, request) {
                    $('#content').html(data);
                    allPages = request.getResponseHeader('x-pages');
                    $('#all_pages').html(allPages);
            });
        }

        function getNotify(){

            $('#modal-action-id').modal('hide');
            $('#dialogContent').html('');

            $.post("Schedule/ListPaged/", {text:'text'}, function (data) {
                 if(data){
                     $('#modal-action-id').modal('show');
                     $('#dialogContent').html(data);

                     const audio = new Audio("/ring.m4a");
                     audio.play();
                 }
            });
        }

        $(function () {

            $.datetimepicker.setDateFormatter('moment');

            setInterval(function() {
               getNotify();
            }, 1000);

            $('#modal-container').on('show.bs.modal', function (event) {
                                
            });

            $('#modal-container').on('hidden.bs.modal', function () {

                $(this).removeData('bs.modal');         
                $('#modal-container .modal-content').empty();

            });

            $(".datetimefield").datetimepicker({
                changeMonth: true,
                changeYear: true,
                changeDay: true,
                changeHour: true,
                changeMinute: true,
                format: 'YYYY-MM-DD hh:mm',
                formatTime: 'h:mm A',
                language: "ru"
            });      

            $.ajaxSetup({ cache: false });
            refresh();

            $("#move_next_button").click(function () {
                $.post("Schedule/MoveNext/", {text:'text'}, function (data) {
                    refresh();
                });                
            });

            $("#end_schedule_button").click(function () {
                $.post("Schedule/EndSchedule/", {text:'text'}, function (data) {
                    refresh();
                });
            });

            $("#refresh_filter_button").click(function () {
                refresh();
            });
            $('#count_items').change(function () {
                refresh();
            });
            $("#begin").click(function () {
                if (page > 1) {
                    page = 1;
                    refresh();
                }
            });
            $("#back").click(function () {
                if (page > 1) {
                    page = page - 1;
                    refresh();
                }
            });
            $("#forward").click(function () {
                if (page < allPages) {
                    page = page + 1;
                    refresh();
                }
            });
            $("#end").click(function () {
                if (page < allPages) {
                    page = allPages;
                    refresh();
                }
            });
        })
    </script>
}
