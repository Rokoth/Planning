@model Planning.Contracts.Model.Project

@{
    ViewData["Title"] = "Проект";
}

<h1>@ViewData["Title"]</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.Path)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.Path)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.AddTime)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.AddTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.IsLeaf)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.IsLeaf)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.LastUsedDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.LastUsedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.Parent)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.Parent)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.Period)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.Period)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(model => model.Priority)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayFor(model => model.Priority)
        </dt>        
    </dl>
    <div class="col-sm-4">
        @Html.DisplayNameFor(model => model.AdditionalTasks)
    </div>
    <div class="col-sm-4">
        @Html.ActionLink("Добавить допзадачу", "AddAdditionalTask", new { }, new { @class = "btn btn-dark" })
    </div>
    <div class="col-sm-4">
        @foreach (var item in Model.AdditionalTasks)
        {
            <div>
                <div style="margin-top:4px;padding:0px;">
                    @Html.HiddenFor(m => item.Id)
                    @Html.LabelFor(m => item.Name) : @Html.DisplayFor(m => item.Name)
                    @Html.LabelFor(m => item.TaskData) : @Html.DisplayFor(m => item.TaskData)
                    @Html.LabelFor(m => item.TaskType) : @Html.DisplayFor(m => item.TaskType)
                    @Html.LabelFor(m => item.TaskCondition) : @Html.DisplayFor(m => item.TaskCondition)
                    @Html.ActionLink("Редактировать", "EditAdditionalTask", new { id = item.Id }, new { @class = "btn btn-dark" })
                    @Html.ActionLink("Удалить", "DeleteAdditionalTask", new { id = item.Id }, new { @class = "btn btn-dark" })
                </div>
                <div id="child_@item.Id" style="margin-left:20px"></div>
            </div>
        }
    </div>
</div>
<div>   
    <a asp-action="Index" class = "btn btn-dark">Вернуться</a>
</div>